# Copia este archivo como functions/.env y pega la clave web de tu proyecto de Firebase
# (Configuración del proyecto → General → Tus apps → apiKey). Es la misma de assets/config.js.
CIC_API_KEY=
# Dirección pública de la página (para el botón «Continuar» del correo de contraseña)
CIC_SITIO=https://cicredmujeresdelcaribe.org/
CIC_ORIGENES=https://cicredmujeresdelcaribe.org,https://www.cicredmujeresdelcaribe.org,https://centrodeinnovacioncomunitaria-hub.github.io,http://localhost:8080,http://127.0.0.1:8080
